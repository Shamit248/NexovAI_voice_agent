# ==============================================================================
# NexovAI Voice AI Clinical Agent - Environment Configuration
# ==============================================================================

# Google Gemini API Key (Recommended: Free quota available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key (Get from https://elevenlabs.io/)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# LLM Configuration
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs Voice & Model Configuration
# Voice ID options:
# 21m00Tcm4TlvDq8ikWAM -> Rachel (Professional, calm clinical assistant)
# EXAVITQu4vr4xnSDxMaL -> Bella
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Server Configuration
PORT=8000
HOST=0.0.0.0
